{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skillguard",
          "informationUri": "https://github.com/Yakitori197/yolab-agent-skill-guard",
          "version": "dev",
          "rules": [
            {
              "id": "ASG001",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hardcoded Secret"
              },
              "fullDescription": {
                "text": "High-confidence credential material embedded in scanned text."
              },
              "help": {
                "text": "Remove the credential and rotate it if it was ever real. Load secrets from the environment or a secret manager at runtime, and reference them as placeholders such as ${SERVICE_API_KEY}. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "secrets"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "ASG002",
              "name": "PrivateAbsolutePath",
              "shortDescription": {
                "text": "Private Absolute Path"
              },
              "fullDescription": {
                "text": "Absolute paths that may leak usernames or private directory layout."
              },
              "help": {
                "text": "Replace absolute personal paths with package-relative paths, or use placeholders such as ~, %USERPROFILE%, or ${HOME} when a home directory is genuinely meant. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg002",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "privacy"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "ASG003",
              "name": "DestructiveCommand",
              "shortDescription": {
                "text": "Destructive Command"
              },
              "fullDescription": {
                "text": "Commands that can irreversibly destroy files, history, or data."
              },
              "help": {
                "text": "Prefer reversible operations (trash instead of rm -rf, git revert instead of reset --hard, soft deletes instead of DROP). If a destructive step is genuinely required, gate it behind explicit user confirmation and narrow its scope to named paths. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg003",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "dangerous-commands"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ASG004",
              "name": "RemotePipeExecution",
              "shortDescription": {
                "text": "Remote Pipe Execution"
              },
              "fullDescription": {
                "text": "Content downloaded from the network and executed without review."
              },
              "help": {
                "text": "Download to a file, review it, pin it by checksum or immutable reference, and only then execute the reviewed copy. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg004",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "ASG005",
              "name": "UndeclaredNetworkAccess",
              "shortDescription": {
                "text": "Undeclared Network Access"
              },
              "fullDescription": {
                "text": "Content instructs network access to hosts the configuration does not allow."
              },
              "help": {
                "text": "List every legitimately required host under allowed_domains in .skillguard.yml, or remove the network step. Declare a \"network\" capability in frontmatter only when configuration permits it. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg005",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "network"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "ASG006",
              "name": "ExcessiveToolPermission",
              "shortDescription": {
                "text": "Excessive Tool Permission"
              },
              "fullDescription": {
                "text": "Skill declares or demands broader tool access than its task needs."
              },
              "help": {
                "text": "Scope each tool grant to the narrowest pattern that still works (for example a single command family instead of an unscoped shell), and declare only capabilities the configuration allows. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg006",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "permissions"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ASG007",
              "name": "PathEscape",
              "shortDescription": {
                "text": "Path Escape"
              },
              "fullDescription": {
                "text": "References that resolve outside the allowed package root."
              },
              "help": {
                "text": "Keep every referenced resource inside the package directory and reference it with a plain relative path. Copy shared assets into the package instead of reaching outside it."
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg007",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "structure"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ASG008",
              "name": "MissingReference",
              "shortDescription": {
                "text": "Missing Reference"
              },
              "fullDescription": {
                "text": "Declared local resources that do not exist."
              },
              "help": {
                "text": "Create the referenced file, fix the path, or delete the stale reference."
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg008",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "structure"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "ASG009",
              "name": "InvalidManifest",
              "shortDescription": {
                "text": "Invalid Manifest"
              },
              "fullDescription": {
                "text": "Frontmatter that is missing, malformed, or of the wrong shape."
              },
              "help": {
                "text": "Give every SKILL.md a YAML frontmatter mapping with string name and description fields; keep field types as documented and remove duplicate keys."
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg009",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "structure"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "ASG010",
              "name": "PromptInjectionSignal",
              "shortDescription": {
                "text": "Prompt Injection Signal"
              },
              "fullDescription": {
                "text": "Phrases that try to override an agent's instructions or hide actions from the user."
              },
              "help": {
                "text": "Rewrite instructions to work with the host platform's rules instead of against them. Legitimate skills never need the agent to hide actions from the user or to abandon prior instructions. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg010",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "injection"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ASG011",
              "name": "UnpinnedRemoteDependency",
              "shortDescription": {
                "text": "Unpinned Remote Dependency"
              },
              "fullDescription": {
                "text": "Remote scripts, actions, or refs addressed by mutable tag or branch."
              },
              "help": {
                "text": "Pin GitHub Actions and raw-content URLs to full 40-character commit SHAs, and pin installed tools to exact versions. Record why each pinned version was chosen. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg011",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "ASG012",
              "name": "ObfuscatedPayload",
              "shortDescription": {
                "text": "Obfuscated Payload"
              },
              "fullDescription": {
                "text": "Large encoded blobs, especially near decode-and-execute instructions."
              },
              "help": {
                "text": "Ship logic as reviewable plain text inside the package. If binary data is unavoidable, distribute it as a separate checksummed artifact — never as an inline blob the agent must decode and run. (Heuristic rule: findings are risk signals requiring human review.)"
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg012",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "obfuscation"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "ASG900",
              "name": "ExpiredSuppression",
              "shortDescription": {
                "text": "Expired Suppression"
              },
              "fullDescription": {
                "text": "A configured suppression has lapsed and no longer silences its finding."
              },
              "help": {
                "text": "Remove the expired suppression if the finding is resolved, or set a new expiry with an updated reason after review."
              },
              "helpUri": "https://github.com/Yakitori197/yolab-agent-skill-guard/blob/main/docs/rules.md#asg900",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "governance"
                ],
                "security-severity": "0.0"
              }
            }
          ]
        }
      },
