<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>skillguard report</title>
<style>
:root {
  --bg: #ffffff;
  --fg: #1a1d21;
  --muted: #57606a;
  --surface: #f6f8fa;
  --border: #d0d7de;
  --accent: #0550ae;
  --critical: #a40e26;
  --high: #bc4c00;
  --medium: #7d4e00;
  --low: #0969da;
  --info: #57606a;
  --pass: #1a7f37;
  --fail: #a40e26;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --fg: #e6edf3;
    --muted: #9198a1;
    --surface: #161b22;
    --border: #30363d;
    --accent: #79c0ff;
    --critical: #ff7b72;
    --high: #f0883e;
    --medium: #d9a834;
    --low: #79c0ff;
    --info: #9198a1;
    --pass: #56d364;
    --fail: #ff7b72;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 0 1rem 3rem;
  background: var(--bg);
  color: var(--fg);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.5;
}
main, header, footer { max-width: 60rem; margin: 0 auto; }
header { padding: 1.5rem 0 0.5rem; }
h1 { font-size: 1.4rem; margin: 0 0 0.25rem; }
h2 { font-size: 1.1rem; margin: 2rem 0 0.75rem; }
.meta { color: var(--muted); margin: 0; font-size: 0.9rem; }
.verdict {
  display: inline-block; margin-top: 0.75rem; padding: 0.25rem 0.75rem;
  border-radius: 0.4rem; font-weight: 700; border: 1px solid var(--border);
}
.verdict.pass { color: var(--pass); }
.verdict.fail { color: var(--fail); }
ul.cards { list-style: none; display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; margin: 0.75rem 0; }
ul.cards li {
  background: var(--surface); border: 1px solid var(--border); border-radius: 0.5rem;
  padding: 0.5rem 1rem; min-width: 6.5rem; text-align: center;
}
ul.cards .num { display: block; font-size: 1.4rem; font-weight: 700; }
table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1rem; }
.table-wrap { overflow-x: auto; }
th, td { text-align: left; padding: 0.35rem 0.75rem; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; }
code, .path { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.9em; }
.filegroup { margin: 1rem 0; }
.filegroup > h3 {
  font-size: 0.95rem; margin: 1.25rem 0 0.5rem;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
}
details.finding {
  border: 1px solid var(--border); border-radius: 0.5rem;
  margin: 0.5rem 0; background: var(--surface);
}
details.finding > summary {
  cursor: pointer; padding: 0.6rem 0.9rem; display: flex; flex-wrap: wrap;
  gap: 0.6rem; align-items: baseline;
}
details.finding > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
details.finding .body { padding: 0 0.9rem 0.9rem; }
.sev { font-weight: 700; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.03em; }
.sev-critical { color: var(--critical); }
.sev-high { color: var(--high); }
.sev-medium { color: var(--medium); }
.sev-low { color: var(--low); }
.sev-info { color: var(--info); }
.pos { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.85rem; }
.ruleid { color: var(--accent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.85rem; }
.msg { flex-basis: 100%; }
dl { margin: 0.5rem 0 0; }
dt { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.6rem; }
dd { margin: 0.15rem 0 0; }
.badge {
  display: inline-block; border: 1px solid var(--border); border-radius: 0.4rem;
  padding: 0 0.4rem; font-size: 0.75rem; color: var(--muted);
}
footer { margin-top: 3rem; color: var(--muted); font-size: 0.85rem; border-top: 1px solid var(--border); padding-top: 1rem; }
</style>
</head>
<body>
<header>
<h1>skillguard report</h1>
<p class="meta">generated by {{.ToolName}} {{.ToolVersion}} — offline, read-only, deterministic</p>
<p><span class="verdict {{.ResultClass}}">{{.Result}}</span> <span class="meta">fail-on threshold: {{.FailOn}}</span></p>
</header>
<main>
<section aria-labelledby="summary-h">
<h2 id="summary-h">Summary</h2>
<ul class="cards">
{{range .Sev}}<li><span class="num {{.Class}}">{{.Count}}</span><span>{{.Name}}</span></li>
{{end}}</ul>
<p class="meta">files scanned: {{.FilesScanned}} · files skipped (never read): {{.FilesSkipped}} · findings suppressed by configuration: {{.Suppressed}} · total findings: {{.TotalFindings}}</p>
</section>
{{if .Rules}}
<section aria-labelledby="rules-h">
<h2 id="rules-h">Findings by rule</h2>
<div class="table-wrap">
<table>
<thead><tr><th scope="col">Rule</th><th scope="col">Title</th><th scope="col">Count</th></tr></thead>
<tbody>
{{range .Rules}}<tr><td class="ruleid">{{.ID}}</td><td>{{.Title}}</td><td>{{.Count}}</td></tr>
{{end}}</tbody>
</table>
</div>
</section>
{{end}}
{{if .Platforms}}
<section aria-labelledby="plat-h">
<h2 id="plat-h">Findings by platform</h2>
<div class="table-wrap">
<table>
<thead><tr><th scope="col">Platform</th><th scope="col">Count</th></tr></thead>
<tbody>
{{range .Platforms}}<tr><td>{{.Name}}</td><td>{{.Count}}</td></tr>
{{end}}</tbody>
</table>
</div>
</section>
{{end}}
<section aria-labelledby="findings-h">
<h2 id="findings-h">Findings</h2>
{{if not .Groups}}<p>No findings.</p>{{end}}
{{range .Groups}}
<div class="filegroup">
<h3>{{.Path}}</h3>
{{range .Rows}}
<details class="finding">
<summary>
<span class="sev {{.SevClass}}">{{.Severity}}</span>
<span class="pos">{{.Line}}:{{.Column}}</span>
<span class="ruleid">{{.RuleID}}</span>
<span>{{.Title}}</span>
{{if .Heuristic}}<span class="badge">heuristic — requires review</span>{{end}}
<span class="msg">{{.Message}}</span>
</summary>
<div class="body">
<dl>
<dt>Why it matters</dt><dd>{{.Rationale}}</dd>
<dt>Remediation</dt><dd>{{.Remediation}}</dd>
<dt>Details</dt><dd>context: {{.Context}} · platform: {{.Platform}} · fingerprint: <code>{{.Fingerprint}}</code></dd>
</dl>
</div>
</details>
{{end}}
</div>
{{end}}
</section>
{{if .Skipped}}
<section aria-labelledby="skipped-h">
<h2 id="skipped-h">Skipped files (never read)</h2>
<div class="table-wrap">
<table>
<thead><tr><th scope="col">Path</th><th scope="col">Reason</th></tr></thead>
<tbody>
{{range .Skipped}}<tr><td class="path">{{.Path}}</td><td>{{.Reason}}</td></tr>
{{end}}</tbody>
</table>
</div>
</section>
{{end}}
</main>
<footer>
<p>skillguard runs fully offline: it reads text, never executes scanned content, never follows symlinks out of the scan root, and never transmits anything. Sensitive files (.env, keys, databases) are reported as skipped without being opened, and suspected secrets are always masked. Heuristic findings are risk signals for human review, not verdicts of malice.</p>
</footer>
</body>
</html>
